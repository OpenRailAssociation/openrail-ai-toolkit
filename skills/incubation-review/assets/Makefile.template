# Incubation Review Makefile
# Generated from openrail-ai-toolkit/skills/incubation-review
#
# Usage: make <target>
# Run from the review workspace directory.
#
# Each tool has a timeout (default 120s). Override with TIMEOUT=<seconds>.
# On macOS, requires gtimeout (brew install coreutils).

REPO_DIR ?= $(error Set REPO_DIR to the path of the checked-out repository)
REPO_URL ?= $(error Set REPO_URL to the GitHub repository URL)
REPORT ?= $(error Set REPORT to the path of the review report Markdown file)
TEMPLATE_DIR ?= $(error Set TEMPLATE_DIR to the path of the incubation-review skill assets)
OUT := $(CURDIR)
TIMEOUT := 120
TIMER := $(shell command -v gtimeout 2>/dev/null || command -v timeout 2>/dev/null || echo "")

# If no timeout command available, run without timeout
RUN := $(if $(TIMER),$(TIMER) $(TIMEOUT),)
OUT := $(CURDIR)

.PHONY: all reuse gitleaks scorecard sbom licensing grype pdf clean setup

all: reuse gitleaks scorecard sbom licensing grype

# --- Setup ---

setup:
	mkdir -p $(OUT)/reuse $(OUT)/gitleaks $(OUT)/scorecard $(OUT)/sbom $(OUT)/grype $(OUT)/licensing

# --- Individual tools ---

reuse: setup
	@echo "[1/6] reuse lint — starting (~10s)..."
	@START=$$(date +%s); \
	$(RUN) sh -c 'cd $(REPO_DIR) && reuse lint' > $(OUT)/reuse/lint.txt 2>&1 || true; \
	echo "       done ($$(($$(date +%s) - $$START))s)"

gitleaks: setup
	@echo "[2/6] gitleaks — starting (~10-30s depending on repo size)..."
	@START=$$(date +%s); \
	$(RUN) sh -c 'cd $(REPO_DIR) && gitleaks detect --no-banner -f json -r $(OUT)/gitleaks/findings.json' 2>$(OUT)/gitleaks/run.log || true; \
	echo "       done ($$(($$(date +%s) - $$START))s)"

scorecard: setup
	@echo "[3/6] scorecard — starting (~30-60s, requires GITHUB_TOKEN)..."
	@START=$$(date +%s); \
	GITHUB_TOKEN=$${GITHUB_TOKEN:-$$(gh auth token 2>/dev/null)} \
	$(RUN) scorecard --repo=$(REPO_URL) --format=json > $(OUT)/scorecard/results.json 2>$(OUT)/scorecard/run.log || true; \
	echo "       done ($$(($$(date +%s) - $$START))s)"

sbom: setup
	@echo "[4/6] sbom generate + enrich — starting (~30-90s, network-dependent)..."
	@START=$$(date +%s); \
	$(RUN) sh -c 'cd $(REPO_DIR) && compliance-assistant sbom generate -g syft -d . -o $(OUT)/sbom/sbom.json' 2>$(OUT)/sbom/generate.log; \
	$(RUN) compliance-assistant sbom enrich -f $(OUT)/sbom/sbom.json -o $(OUT)/sbom/sbom-enriched.json 2>$(OUT)/sbom/enrich.log || true; \
	echo "       done ($$(($$(date +%s) - $$START))s)"

licensing: sbom
	@echo "[5/6] licensing — starting (~5-10s)..."
	@START=$$(date +%s); \
	$(RUN) compliance-assistant licensing list -f $(OUT)/sbom/sbom-enriched.json -o plain --no-simplify > $(OUT)/licensing/licenses.txt 2>$(OUT)/licensing/run.log || true; \
	echo "       done ($$(($$(date +%s) - $$START))s)"

grype: sbom
	@echo "[6/6] grype — starting (~10-30s, first run downloads DB)..."
	@START=$$(date +%s); \
	$(RUN) grype --add-cpes-if-none sbom:$(OUT)/sbom/sbom-enriched.json > $(OUT)/grype/vulnerabilities.txt 2>$(OUT)/grype/run.log || true; \
	echo "       done ($$(($$(date +%s) - $$START))s)"

clean:
	rm -rf reuse/ gitleaks/ scorecard/ sbom/ grype/ licensing/ report.pdf

pdf:
	pandoc $(REPORT) \
		--pdf-engine=typst \
		--template=$(TEMPLATE_DIR)/review-template.typ \
		--metadata title="$(TITLE)" \
		--metadata date="$(DATE)" \
		-f markdown-citations \
		--lua-filter=$(TEMPLATE_DIR)/auto-columns.lua \
		-o $(OUT)/report.pdf
